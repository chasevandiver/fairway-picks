# Copy to .env.local for local development. All three are required.

# Supabase project URL and anon (public) key — Settings → API in the Supabase dashboard.
# Used by the browser client (src/lib/supabase.ts) for auth and RLS-protected reads/writes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (secret — never expose to the browser, never commit).
# Used server-side only by the API routes in src/app/api/ and src/app/join/[code]/page.tsx.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
